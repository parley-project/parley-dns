# The settings parley-dns reads, for the servers' start-up check
# (format: parley-net's KnownSettings). Add a name here when code here starts reading it.

# the TCP listener is a framework server with this prefix
prefix parley.dns.tcp

# the domain list is pluggable (IDomainList): its own settings are under its setting
parley.dns.domainList.*

parley.dns.axfrAllow
parley.dns.axfrKeys
parley.dns.bindAddress
parley.dns.cacheSweepInterval
parley.dns.configFile
parley.dns.debug
parley.dns.delegationMaxAge
parley.dns.dnsDir
parley.dns.dnssecKeyDir
parley.dns.dnssecNsec3
parley.dns.dnssecNsec3Iterations
parley.dns.dnssecNsec3Salt
parley.dns.dnssecTrustAnchors
parley.dns.dnssecValidation
parley.dns.dnssecValidity
parley.dns.domainList
parley.dns.ednsUdpSize
parley.dns.exitOnFatalError
# the server's file system (a factory type id) and its connection settings
parley.dns.fileSource
parley.dns.fileSource.**

parley.dns.masterZone
parley.dns.maxCacheAge
parley.dns.maxCacheEntries
parley.dns.maxDelegations
parley.dns.maxNegativeTtl
parley.dns.notify
parley.dns.notifyKey
parley.dns.notifyRetries
parley.dns.notifyTimeout
parley.dns.port
parley.dns.recursionAvailable
parley.dns.resolvConf
parley.dns.resolveTimeout
parley.dns.resolverMaxBacklog
parley.dns.resolverMaxQueueAge
parley.dns.resolverVirtualThreads
parley.dns.resolvers
parley.dns.sharedZone
parley.dns.reportAuthorizations
parley.dns.tcpBacklog
parley.dns.tcpBindAddress
parley.dns.tcpIdleTimeout
parley.dns.tcpMaxConnections
parley.dns.tcpMaxConnectionsPerClient
parley.dns.tcpPort
parley.dns.tcpProcCount
parley.dns.tcpTimeout
parley.dns.timeout
parley.dns.tsigFudge
parley.dns.tsigKeyFile
parley.dns.tsigKeys
parley.dns.udpBindAddress
parley.dns.udpDumpFile
parley.dns.udpMaxResponse
parley.dns.udpPort
parley.dns.udpProcCount
parley.dns.udpTimeout
parley.dns.updateAllow
parley.dns.updateKeys
parley.dns.upstreamHoldOffMax
parley.dns.upstreamHoldOffMin
parley.dns.zoneCutReferrals
parley.dns.zoneDir

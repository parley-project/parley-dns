<project
	xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-dns</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>Parley DNS</name>
	<description>An implementation of the DNS protocol in Java for both server and client,
		with DNSSEC, dynamic update and work-alikes of nslookup and nsupdate.
		Formerly us.bringardner:bjl_dns.</description>
	<inceptionYear>1999</inceptionYear>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.dns</parley.moduleName>
	</properties>

	<build>
		<!-- <sourceDirectory>src</sourceDirectory> -->
		<!--
			Plugins that must run in every build are declared here. They used to be
			only in pluginManagement, which configures a plugin but does not use it,
			so Maven's default (older) compiler and surefire versions were used.
		-->
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
			<plugin>
				<!--
					Static analysis, not bound to a phase (the legacy code has many
					findings). Run it with:  mvn compile spotbugs:check
					or browse the results with: mvn compile spotbugs:gui
					find-sec-bugs adds security checks (injection, weak crypto, ...).
				-->
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.8.6.6</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Medium</threshold>
					<plugins>
						<plugin>
							<groupId>com.h3xstream.findsecbugs</groupId>
							<artifactId>findsecbugs-plugin</artifactId>
							<version>1.13.0</version>
						</plugin>
					</plugins>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>3.1.0</version>
					<executions>
						<execution>
							<id>attach-sources</id>
							<goals>
								<goal>jar</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<artifactId>maven-deploy-plugin</artifactId>
					<version>2.8.2</version>
				</plugin>
				<plugin>
					<groupId>com.github.github</groupId>
					<artifactId>site-maven-plugin</artifactId>
					<version>0.12</version>
					<configuration>
						<message>Maven artifacts for ${project.version}</message>
						<noJekyll>true</noJekyll>
						<outputDirectory>${project.build.directory}</outputDirectory>
						<branch>refs/heads/${branch-name}</branch>
						<includes>
							<include>**/*</include>
						</includes>
						<merge>true</merge>
						<repositoryName>parley-dns</repositoryName>
						<repositoryOwner>tony-bringardner</repositoryOwner>
						<server>github</server>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>site</goal>
							</goals>
							<phase>deploy</phase>
						</execution>
					</executions>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.2</version>
					<configuration>
						<test><!-- your test suite class name should be here -->
						</test>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/parley-dns</url>
		</repository>

	</distributionManagement>


	<dependencies>
		<dependency>
			<!-- was bjl_core -->
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-core</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<dependency>
			<!-- was bjl_io -->
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-io</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!--
		https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter-engine -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>5.11.4</version>
			<scope>test</scope>
		</dependency>

		<!--
		https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter-api -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>5.11.4</version>
			<scope>test</scope>
		</dependency>


		<!--
			MySQL driver for the optional database (JDns.jdbcURL). It was test scope,
			so it was missing at run time; mysql:mysql-connector-java is also the old
			coordinate (relocated to com.mysql:mysql-connector-j). Optional: projects
			that use this jar as a DNS library don't get MySQL transitively.
		-->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<version>8.4.0</version>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

	</dependencies>

</project>